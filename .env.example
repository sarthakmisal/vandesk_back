# Copy to .env (local) or set the same names in Vercel > Settings > Environment Variables.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
NODE_ENV=production            # on Vercel this is set for you
PORT=3000
AUTH_SECRET=                   # required in production, 16+ random characters
CRON_SECRET=                   # Vercel Cron sends it as a Bearer token to /api/internal/jobs/*
AUTO_MIGRATE=0                 # 1 = create the tables on start when the database is empty
SEED_DEMO=0                    # 1 = load demo data on an empty database
SMTP_HOST=                     # required in production: sign-in codes are emailed
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VanDesk <no-reply@yourdomain.com>
# DB_SSL_INSECURE=1            # only for a self-signed PostgreSQL server
# CORS_ORIGINS=https://app.example.com   # extra browser origins allowed to call the API (the Ionic app origins are built in)
