{
  "name": "vandesk-backend",
  "version": "2.0.0",
  "description": "VanDesk API: Express + PostgreSQL. Also serves the Ionic build from public/.",
  "main": "index.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true});console.log('Local dev database removed')\"",
    "test": "node --test \"test/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarthakmisal/vandesk_back.git"
  },
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.0",
    "express": "^5.1.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.16.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0"
  }
}
