{
  "version": 2,
  "builds": [
    { "src": "index.js", "use": "@vercel/node", "config": { "includeFiles": ["public/**", "db/**"] } }
  ],
  "routes": [{ "src": "/(.*)", "dest": "index.js" }],
  "crons": [
    { "path": "/api/internal/jobs/generate-dues", "schedule": "0 19 * * *" },
    { "path": "/api/internal/jobs/send-reminders", "schedule": "30 4 * * *" },
    { "path": "/api/internal/jobs/retention", "schedule": "0 20 * * 0" }
  ]
}
